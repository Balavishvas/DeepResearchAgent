# Google Gemini API Key (Required for Gemini models)
# Get your API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (Required for Groq models e.g. Qwen/Llama)
# Get your API key from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# Tavily API Key (Required for web search)
# Get your API key from: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# LangSmith / LangChain Tracing (Optional - for debugging and monitoring)
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langchain_api_key_here
# LANGCHAIN_PROJECT=deep-research-agent
