# LLM provider used by every agent: ollama (local) or gemini (cloud)
LLM_PROVIDER=ollama

# Ollama settings (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Gemini settings (required only when LLM_PROVIDER=gemini)
GEMINI_API_KEY=your_gemini_api_key_here
# GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Tavily web search is required for online research in either provider mode
TAVILY_API_KEY=your_tavily_api_key_here

# Optional LangSmith tracing
# LANGCHAIN_TRACING_V2=true
# LANGCHAIN_API_KEY=your_langsmith_api_key
# LANGCHAIN_PROJECT=deep-research-agent
